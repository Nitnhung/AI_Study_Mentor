# ── Sao chép thành .env và điền key thật. TUYỆT ĐỐI không commit .env lên Git ──

# Thứ tự ưu tiên provider (failover tự động từ trái sang phải)
# Điền key provider nào thì đặt nó lên đầu.
AI_PROVIDER_PRIORITY=gemini,claude,openai,mock

# ── Google Gemini ────────────────────────────────────────────────────
# Lấy key MIỄN PHÍ tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash

# ── Anthropic Claude ─────────────────────────────────────────────────
# Lấy key tại: https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── OpenAI (ChatGPT) ────────────────────────────────────────────────
# Lấy key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Quản lý chi phí ─────────────────────────────────────────────────
AI_CACHE_ENABLED=true
AI_SIMILARITY_THRESHOLD=0.90
AI_CACHE_TTL_SECONDS=2592000
AI_MAX_OUTPUT_TOKENS=1500

# ── Độ bền ───────────────────────────────────────────────────────────
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF=1.5

# ── An toàn nội dung ────────────────────────────────────────────────
AI_MODERATION_ENABLED=true
AI_MAX_QUESTION_CHARS=4000
